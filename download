<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Omar Kurdi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="css/style.css" />
</head>
<body>

  <header class="hero">
    <div class="hero__frame">
      <p class="eyebrow">Personal archive</p>
      <h1 class="hero__name">Omar Kurdi</h1>
      <p class="hero__bio">
        Computer Science student at UC San Diego, co-founder of the e-commerce
        brand <a href="https://thawban.netlify.app" target="_blank" rel="noopener">Thawban</a>,
        and CFO of Ethix, a student-built AI compliance startup. This page is
        where I keep the photos and clips worth holding onto.
      </p>
      <nav class="hero__nav">
        <a href="#photos">Photos</a>
        <a href="#videos">Videos</a>
      </nav>
    </div>
  </header>

  <div class="sprocket-divider" aria-hidden="true"></div>

  <main>
    <section id="photos" class="gallery-section">
      <div class="section-head">
        <h2>Photos</h2>
        <span class="section-count" id="photo-count"></span>
      </div>
      <div class="gallery gallery--photos" id="photo-gallery"></div>
    </section>

    <div class="sprocket-divider" aria-hidden="true"></div>

    <section id="videos" class="gallery-section">
      <div class="section-head">
        <h2>Videos</h2>
        <span class="section-count" id="video-count"></span>
      </div>
      <div class="gallery gallery--videos" id="video-gallery"></div>
    </section>
  </main>

  <footer class="site-footer">
    <p>Built with a very basic GitHub Pages site.</p>
  </footer>

  <!-- Lightbox for photos -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button class="lightbox__close" id="lightbox-close" aria-label="Close">&times;</button>
    <img class="lightbox__img" id="lightbox-img" src="" alt="" />
  </div>

  <script src="js/script.js"></script>
</body>
</html>
